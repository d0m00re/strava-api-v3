# integration tests only: pnpm test:integration (every suite is skipped without STRAVA_ACCESS_TOKEN)
STRAVA_CLIENT_ID=...
STRAVA_CLIENT_SECRET=...
STRAVA_ACCESS_TOKEN=...
STRAVA_REFRESH_TOKEN=...

# optional, the tests that need one of these ids are skipped when it is not set
STRAVA_ACTIVITY_ID=...
STRAVA_CLUB_ID=...
STRAVA_GEAR_ID=...
STRAVA_ROUTE_ID=...
STRAVA_SEGMENT_ID=...
STRAVA_SEGMENT_EFFORT_ID=...
# single use, get a new one with getAskAuthUrl
STRAVA_AUTH_CODE=...

# 1 = also run the tests that modify the account (upload, weight, star)
STRAVA_WRITE_TESTS=0
