{
  "name": "strava-api-v3",
  "type": "module",
  "version": "0.0.48",
  "description": "strava-api-v3 wrapper",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -Rf ./dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "check:package": "pnpm build && publint && attw --pack . --profile node16",
    "checkUpdate": "pnpm dlx npm-check-updates",
    "release": "pnpm publish",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d0m00re/strava-api-v3.git"
  },
  "keywords": [
    "strava",
    "strava api v3",
    "typescript"
  ],
  "author": "d0m00re",
  "license": "MIT",
  "private": false,
  "bugs": {
    "url": "https://github.com/d0m00re/strava-api-v3/issues"
  },
  "homepage": "https://github.com/d0m00re/strava-api-v3#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "dotenv": "^16.4.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
